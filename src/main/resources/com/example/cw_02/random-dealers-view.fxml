<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="450.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cw_02.Controllers.DealerSelectionController">
   <children>
      <TableView fx:id="dealerTable" layoutY="80.0" prefHeight="290.0" prefWidth="650.0">
        <columns>
          <TableColumn fx:id="colId" prefWidth="95.99999845027924" text="Dealer ID" />
          <TableColumn fx:id="colName" prefWidth="54.39997100830078" text="Dealer Name" />
            <TableColumn fx:id="colLocation" prefWidth="75.0" text="Location" />
            <TableColumn fx:id="colContact" prefWidth="75.0" text="Contact Number" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <Button layoutX="280.0" layoutY="388.0" mnemonicParsing="false" onAction="#handleSelection" text="Select Dealers" />
      <Label layoutX="200.0" layoutY="27.0" text="Random Dealer Selection">
         <font>
            <Font name="Comic Sans MS Bold" size="18.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
