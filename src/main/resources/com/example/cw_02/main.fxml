<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="520.0" prefWidth="731.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cw_02.Controllers.MainController">
   <children>
      <Label layoutX="10.0" layoutY="30.0" prefHeight="26.0" prefWidth="712.0" text="Welcome To Malabe Tuk-Tuk &amp; Three-Wheeler Spares Depot Inventory System" textAlignment="RIGHT">
         <font>
            <Font name="Comic Sans MS Bold Italic" size="18.0" />
         </font>
      </Label>
      <Label layoutX="211.0" layoutY="92.0" prefHeight="18.0" prefWidth="277.0" text="Click a button According to your requirement ">
         <font>
            <Font name="Candara Bold" size="14.0" />
         </font>
      </Label>
      <VBox layoutX="225.0" layoutY="133.0" prefHeight="290.0" prefWidth="249.0" spacing="10.0">
         <children>
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#openDataCleaner" text="Clean Legacy Data files " />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#openAddItem" prefHeight="26.0" prefWidth="163.0" text="Add An Item To the Inventory" />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#openDeleteItem" prefHeight="26.0" prefWidth="162.0" text="Delete An Item From the Inventory" />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#openUpdateItem" text="Upadte Item Details" />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#openViewInventory" text="View Inventory" />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#openSearchWindow" prefHeight="15.0" prefWidth="255.0" text="Search for an item in the inventory " />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#openLowStock" text="check items on low stock " />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#openDealerSelection" text="Select Random Dealers " />
         </children>
      </VBox>
   </children>
</AnchorPane>
