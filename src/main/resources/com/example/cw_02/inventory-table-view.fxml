<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cw_02.Controllers.InventoryTableController">
    <children>
        <TableView fx:id="inventoryTable" prefHeight="499.0" prefWidth="900.0">
            <columns>
                <TableColumn fx:id="colImage" prefWidth="75.0" text="Image" />
                <TableColumn fx:id="colCode" prefWidth="50.0" text="Code" />
                <TableColumn fx:id="colName" prefWidth="200.0" text="Name" />
                <TableColumn fx:id="colBrand" prefWidth="75.0" text="Brand" />
                <TableColumn fx:id="colCategory" prefWidth="75.0" text="Category" />
                <TableColumn fx:id="colPrice" prefWidth="75.0" text="Price " />
                <TableColumn fx:id="colStock" prefWidth="75.0" text="Stock" />
                <TableColumn fx:id="colDate" prefWidth="75.0" text="Date" />
                <TableColumn fx:id="colStatus" prefWidth="75.0" text="Status" />
            </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
        </TableView>
        <Button layoutX="47.0" layoutY="505.0" mnemonicParsing="false" onAction="#handleLoadInventory" text="Load Inventory" />
        <Label fx:id="totalValueLabel" layoutX="183.0" layoutY="508.0" prefHeight="18.0" prefWidth="378.0" />

        <!-- New Cart & Checkout Features -->
        <Label layoutX="707.0" layoutY="509.0" text="Qty:" />
        <TextField fx:id="quantityField" layoutX="736.0" layoutY="505.0" prefHeight="25.0" prefWidth="50.0" promptText="0" />
        <Button layoutX="803.0" layoutY="504.0" mnemonicParsing="false" onAction="#handleAddToCart" text="Add to Cart" />
        <Button layoutX="809.0" layoutY="560.0" mnemonicParsing="false" onAction="#handleCheckout" text="Checkout" />
    </children>
</AnchorPane>
